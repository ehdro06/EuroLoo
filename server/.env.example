PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/euroloo
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60
# Daily photo limits (UTC days)
UPLOADS_GLOBAL_PER_DAY=500
UPLOADS_USER_PER_DAY=50
UPLOADS_TRUSTED_PER_DAY=200
# Number of reverse proxies in front of the API (1 on Cloud Run)
TRUST_PROXY_HOPS=1
GCS_BUCKET_NAME=euroloo-images-bucket
# Allowed frontend origins in production (comma-separated)
CORS_ORIGINS=https://euroloo.vercel.app
# Optional shared cache/rate limits; omit to use in-memory (e.g. rediss://default:password@host:6379)
# REDIS_URL=
